    "amqplib": "^0.10.5",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "next": "^16.3.6",
    "openid-client": "^6.8.8",
    "payload": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
