{
  "name": "baobab-cms",
  "version": "0.1.0",
  "packageManager": "npm@10.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "payload migrate",
