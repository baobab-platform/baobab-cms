{
  "name": "baobab-cms",
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "payload migrate",
    "db:generate": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "outbox:dispatch": "tsx scripts/outbox/dispatch.ts",
    "reconcile": "tsx scripts/reconciliation/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.6",
    "graphql": "^16.9.0",
    "jose": "6.2.12",
    "next": "16.4.2",
    "openid-client": "^6.8.8",
    "payload": "3.92.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "7.29.1",
    "source-map-js": "1.2.2",
    "sass": {
      "chokidar": "4.0.3"
    },
    "dompurify": "3.4.16"
  }
}
